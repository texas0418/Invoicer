{
  "expo": {
    "name": "Billowe",
    "slug": "billowe",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.billowe.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Billowe needs access to your photos so you can add a logo to your invoices and estimates."
      },
      "buildNumber": "12"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.billowe.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "billowe",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "extra": {
      "eas": {
        "projectId": "5c127f3c-da40-41e7-8cf2-20666ca22b4c"
      }
    },
    "plugins": [
      "./plugins/withReleaseSigning.js"
    ]
  }
}